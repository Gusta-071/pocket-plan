# Porta da API (o Vite encaminha /api para ela em desenvolvimento)
API_PORT=3333

# Banco SQLite local
DATABASE_URL="file:./data/pocket-plan.db"

# Endereço da interface, usado no link de redefinição de senha
APP_URL="http://localhost:5173"

# E-mail (RN-09e). Sem SMTP_HOST, o link de redefinição aparece no console da API.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="pocket-plan <no-reply@pocket-plan.local>"

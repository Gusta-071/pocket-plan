generator client {
  provider     = "prisma-client"
  output       = "../server/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "sqlite"
}

// Modelos do domínio, seguindo docs/REGRAS-DE-NEGOCIO.md.

/// Conta de usuário (RN-05 a RN-09).
model User {
  id                  Int       @id @default(autoincrement())
  name                String
  /// Normalizado: sem espaços nas pontas e em minúsculas (RN-06).
  email               String    @unique
  passwordHash        String
  /// Dia de início do mês financeiro, de 1 a 28 (RN-10).
  monthStartDay       Int       @default(1)
  /// AUTO | START_MONTH | END_MONTH (RN-12).
  periodNaming        String    @default("AUTO")
  /// Ponto de partida do saldo acumulado, em centavos; pode ser negativo (RN-28a, RN-44a).
  initialBalanceCents Int       @default(0)
  /// Nível de atenção do orçamento, em % do limite, de 0 a 100 (RN-32a).
  warningPercent      Int       @default(80)
  /// LIGHT | DARK | SYSTEM (RN-45).
  theme               String    @default("SYSTEM")
  /// Preenchido quando o usuário confirma o e-mail (RN-09f, RN-09i).
  emailVerifiedAt     DateTime?
  createdAt           DateTime  @default(now())

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  categories              Category[]
  entries                 Entry[]
  budgets                 Budget[]
  paymentMethods          PaymentMethod[]
  cards                   Card[]
  installments            Installment[]
}

/// Código de confirmação de e-mail: só o hash, 24 horas, uso único (RN-09f).
model EmailVerificationToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Sessão de login, válida por 7 dias (RN-08). O cookie guarda o token; o banco, só o hash.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Código de redefinição de senha: só o hash, 30 minutos, uso único (RN-09b).
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Eventos usados nos limites por e-mail: LOGIN_FAILURE (RN-08c), PASSWORD_RESET_REQUEST (RN-09c)
/// e EMAIL_VERIFICATION_SENT (RN-09h). Registra também e-mails não cadastrados.
model AuthAttempt {
  id        Int      @id @default(autoincrement())
  kind      String
  email     String
  createdAt DateTime @default(now())

  @@index([kind, email, createdAt])
}

/// Categoria de receita ou despesa, de um único nível (RN-14 a RN-18a).
model Category {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// INCOME | EXPENSE. Não muda depois de criada (RN-17).
  type         String
  name         String
  /// Nome sem espaços nas pontas e em minúsculas: garante a unicidade de RN-16.
  nameKey      String
  /// Chave da paleta fixa (RN-16a), ex.: "green", "blue".
  color        String
  /// Classe da despesa (RN-14a): FIXED | VARIABLE | INVESTMENT. Nula nas categorias de receita.
  expenseClass String?
  createdAt    DateTime @default(now())
  entries      Entry[]
  budgets      Budget[]

  @@unique([userId, type, nameKey])
  @@index([userId])
}

/// Lançamento de receita ou despesa (RN-19 a RN-25d).
model Entry {
  id                Int            @id @default(autoincrement())
  userId            Int
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// INCOME | EXPENSE, igual ao tipo da categoria (RN-21).
  type              String
  /// Valor em centavos, maior que zero (RN-01, RN-20).
  amountCents       Int
  /// Data sem horário, "AAAA-MM-DD" (RN-03). O formato ordena corretamente como texto.
  date              String
  categoryId        Int
  /// Restrict: uma categoria com lançamentos só sai movendo-os antes (RN-18).
  category          Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description       String?
  /// Pago (despesa) ou recebido (receita), marcado pelo usuário (RN-22).
  paid              Boolean        @default(false)
  /// Forma de pagamento (RN-67). Só nas despesas; nula nas receitas.
  paymentMethodId   Int?
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  /// Cartão da compra no crédito (RN-52). Nulo nas demais formas.
  cardId            Int?
  card              Card?          @relation(fields: [cardId], references: [id], onDelete: Restrict)
  /// Data de pagamento (RN-52a): igual à data, ou o vencimento da fatura nas compras no cartão (RN-53, RN-53a).
  payDate           String
  /// Parcelamento a que pertence (RN-56, RN-56a) e o número da parcela, a partir de 1.
  installmentId     Int?
  installment       Installment?   @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  installmentNumber Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId, date])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([cardId])
  @@index([userId, payDate])
  @@index([installmentId])
}

/// Limite de orçamento ou meta, com vigência (RN-29 a RN-34).
/// Cada alteração gera um registro novo; o valor de um período é o do registro mais recente
/// com `validFrom` até o fim do período. Assim, os períodos anteriores mantêm o valor que tinham (RN-30).
model Budget {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CATEGORY_LIMIT | CLASS_LIMIT | INVESTMENT_GOAL | SAVINGS_GOAL.
  kind         String
  /// Só em CATEGORY_LIMIT. Excluir a categoria remove o limite dela (RN-18).
  categoryId   Int?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Só em CLASS_LIMIT: FIXED | VARIABLE (RN-29a).
  expenseClass String?
  /// Em centavos. Nulo quando o usuário removeu o limite ou a meta.
  amountCents  Int?
  /// Dia em que a alteração foi feita ("YYYY-MM-DD"): vale do período que o contém em diante.
  validFrom    String
  createdAt    DateTime  @default(now())

  @@index([userId, kind])
  @@index([categoryId])
}

/// Forma de pagamento das despesas (RN-67 a RN-70).
/// As padrão (PIX, DEBIT, CREDIT, CASH, BOLETO) e a "Não informada" (UNSPECIFIED) são criadas com a conta;
/// as personalizadas (CUSTOM) são do usuário.
model PaymentMethod {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// PIX | DEBIT | CREDIT | CASH | BOLETO | UNSPECIFIED | CUSTOM.
  kind      String
  name      String
  /// Nome sem espaços nas pontas e em minúsculas: garante a unicidade de RN-69.
  nameKey   String
  createdAt DateTime @default(now())
  entries   Entry[]

  @@unique([userId, nameKey])
  @@index([userId])
}

/// Cartão de crédito (RN-51, RN-57). Limite e datas são usados nas faturas (RN-53 a RN-55).
model Card {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  nameKey    String
  /// Chave da paleta fixa (RN-16a).
  color      String
  limitCents Int
  closingDay Int
  dueDay     Int
  /// Preenchido quando o cartão é arquivado (RN-57): some das compras novas, mas mantém o histórico.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  entries    Entry[]

  @@unique([userId, nameKey])
  @@index([userId])
}

/// Parcelamento (RN-56, RN-56a): agrupa as parcelas de uma compra, que são lançamentos comuns.
model Installment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Número de parcelas, de 2 a 480.
  count     Int
  createdAt DateTime @default(now())
  entries   Entry[]

  @@index([userId])
}
